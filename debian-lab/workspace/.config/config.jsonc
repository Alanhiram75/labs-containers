{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "debian_small",
        "padding": {
            "top": 1,
            "bottom": 1,
            "right": 1
        }
    },

    "display": {
        "separator": " ➜ ",
        "key": {
            "width": 0
        }
    },

    "modules": [
        "break",
        {
            "type": "os",
            "key": "Hp",
            "keyColor": "#d5e6d6",
            "outputColor": "#d5e6d6"
        },
        {
            "type": "kernel",
            "key": " ├ 󰌽 ",
            "keyColor": "#d5e6d6"
        },
        {
            "type": "shell",
            "key": " ├ 󰞷 ",
            "keyColor": "#d5e6d6"
        },
        {
            "type": "memory",
            "key": " └ 󰍛 ",
            "keyColor": "#d5e6d6"
        },
        "break"
    ]
}
